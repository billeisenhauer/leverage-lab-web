#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"

if [ ! -f ".env" ]; then
    "$SCRIPT_DIR/init"
fi

source .env

echo "Building $SITE_NAME Jekyll image..."
docker compose -f docker-compose.dev.yml build
echo "Build complete."
